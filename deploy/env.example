# macrae environment. Copy to deploy/.env (git-ignored) and fill in; never commit the filled file.
#   cp deploy/env.example deploy/.env
# Used by: `make serve` (local backend), cloudflare/deploy.sh (`make deploy`: the secrets below are uploaded as
# Worker secrets, which the Worker passes to the backend container; see deploy/cloudflare.md), `make voice-setup`,
# and the AWS alternative (deploy/compose.yaml, deploy/aws_deploy.sh).
# Instead of this file you can put the secrets on the Worker yourself: cd cloudflare && npx wrangler secret put NAME.
# Lines left commented out use the default shown. A blank value counts as unset.

# ── backend (server/, rag/, tasks/) ─────────────────────────────────────────────────────────────────────────
# Shared secret: the Worker and the ElevenLabs tools send it as header X-Macrae-Secret. Required.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MACRAE_TOOL_SECRET=

# Paths, relative to the repo root (in the container they are /data/papers, /data/index, /data/agent-runner).
# MACRAE_PAPERS_DIR=
# MACRAE_INDEX_DIR=
# MACRAE_TASKS_FILE=

# Modal (Harbor runs agent steps on Modal). Locally a profile from ~/.modal.toml is enough (default acalincarol);
# on a server give the token pair. cloudflare/deploy.sh and aws_deploy.sh copy the pair from ~/.modal.toml if
# these are empty.
# MODAL_PROFILE=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Claude logins for agent steps: one or more AGENT_RUNNER_TOKEN_<NAME> (from `claude setup-token`),
# and/or ANTHROPIC_API_KEY (API billing, account "api-key").
# AGENT_RUNNER_TOKEN_<NAME>=
AGENT_RUNNER_TOKEN_MAIN=
ANTHROPIC_API_KEY=

# agent_runner state: runs, leases, Harbor job folders (traces). Default ~/.local/share/agent-runner.
# AGENT_RUNNER_HOME=

# ── Cloudflare Worker (cloudflare/) ────────────────────────────────────────────────────────────────────────
# Local development only: where `make web-dev` / the Worker sends /api/* instead of the backend container.
# Never uploaded by cloudflare/deploy.sh (it refuses to deploy if BACKEND_URL is a Worker secret).
# AWS alternative: leave it empty, `make aws-web-secrets` takes the EC2 URL from deploy/.state.
BACKEND_URL=
ELEVENLABS_API_KEY=
# printed by `make voice-setup` after the first deploy
ELEVENLABS_AGENT_ID=
# cloudflare/deploy.sh: public URL if you put a custom domain on the Worker (default: the workers.dev URL it
# saves in deploy/.state/cloudflare.env); seconds to wait for /api/health after a deploy
# MACRAE_PUBLIC_URL=
# MACRAE_HEALTH_WAIT=
# Backend container tuning, set as [vars] in cloudflare/wrangler.toml (the Worker forwards them): R2 sync timer
# in seconds (60), seconds running flows get to finish when the container stops (840)
# MACRAE_SYNC_INTERVAL=
# MACRAE_DRAIN_SECONDS=

# ── optional knobs read by other modules (see their NOTES.md) ───────────────────────────────────────────────
# tasks/agent_runner: registry image Modal pulls for agent steps (faster than installing Claude Code per trial)
# AGENT_RUNNER_MODAL_IMAGE=
# tasks: docker instead of modal for local development
# MACRAE_HARBOR_ENV=
# server: task runs allowed at once (default 4, 0 = no limit)
# MACRAE_MAX_ACTIVE_RUNS=
# rag: fastembed (default) | hash | none
# MACRAE_EMBEDDER=
# voice (make voice-setup): voice from the ElevenLabs library, LLM override, EU residency API base
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_LLM=
# ELEVENLABS_API_BASE=

# ── AWS deploy (deploy/aws_deploy.sh); all optional ─────────────────────────────────────────────────────────
# Your own domain (an A record pointing at the instance's Elastic IP). Default: <ip-with-dashes>.sslip.io
# MACRAE_DOMAIN=
# AWS_REGION=
# MACRAE_INSTANCE_TYPE=
# MACRAE_DISK_GB=
# MACRAE_NAME=
