#!/usr/bin/env python3
"""Fake AWS CLI for deploy/tests: answers the calls aws_deploy.sh makes, in `--output text` form, from a JSON
state file ($FAKE_DIR/aws.json). Every call is appended to $FAKE_DIR/calls.log."""
import json, os, sys
from pathlib import Path

d = Path(os.environ["FAKE_DIR"])
state_p = d / "aws.json"
st = json.loads(state_p.read_text()) if state_p.exists() else {
    "keys": [], "sgs": {}, "instances": {}, "eips": {}, "n": 0}
args = sys.argv[1:]
with open(d / "calls.log", "a") as f:
    f.write(json.dumps(args) + "\n")


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def save():
    state_p.write_text(json.dumps(st))


def fail(code, msg):
    sys.stderr.write(f"An error occurred ({code}): {msg}\n")
    sys.exit(254)


# drop global options
while args and args[0] in ("--region", "--output"):
    args = args[2:]
svc, op = args[0], (args[1] if len(args) > 1 else "")
filters = " ".join(a for a in args if a.startswith("Name="))

if svc == "configure":
    sys.exit(1)
if (svc, op) == ("sts", "get-caller-identity"):
    print("123456789012")
elif (svc, op) == ("ssm", "get-parameter"):
    print("ami-arm64" if "/arm64/" in opt("--name") else "ami-amd64")
elif svc == "ec2":
    if op == "describe-key-pairs":
        if opt("--key-names") not in st["keys"]:
            fail("InvalidKeyPair.NotFound", "not found")
        print(opt("--key-names"))
    elif op == "import-key-pair":
        st["keys"].append(opt("--key-name"))
    elif op == "delete-key-pair":
        st["keys"] = [k for k in st["keys"] if k != opt("--key-name")]
    elif op == "describe-vpcs":
        print("vpc-1")
    elif op == "describe-subnets":
        print("subnet-1")
    elif op == "describe-security-groups":
        name = filters.split("Name=group-name,Values=")[1].split()[0]
        print(st["sgs"].get(name, {}).get("id", "None"))
    elif op == "create-security-group":
        st["sgs"][opt("--group-name")] = {"id": "sg-1", "rules": []}
        print("sg-1")
    elif op == "authorize-security-group-ingress":
        sg = next(v for v in st["sgs"].values() if v["id"] == opt("--group-id"))
        perm = opt("--ip-permissions")
        if perm in sg["rules"]:
            fail("InvalidPermission.Duplicate", "the rule already exists")
        sg["rules"].append(perm)
    elif op == "delete-security-group":
        st["sgs"] = {k: v for k, v in st["sgs"].items() if v["id"] != opt("--group-id")}
    elif op == "describe-images":
        print("/dev/sda1")
    elif op == "run-instances":
        st["n"] += 1
        iid = f"i-{st['n']}"
        st["instances"][iid] = {"state": "running", "type": opt("--instance-type")}
        print(iid)
    elif op == "describe-instances":
        name = filters.split("Name=tag:Name,Values=")[1].split()[0]
        for iid, i in st["instances"].items():
            if i["state"] != "terminated" and name == "macrae-backend":
                print(f"{iid}\t{i['state']}\t{i['type']}")
    elif op in ("start-instances", "stop-instances", "terminate-instances"):
        st["instances"][opt("--instance-ids")]["state"] = {
            "start-instances": "running", "stop-instances": "stopped", "terminate-instances": "terminated"}[op]
    elif op == "wait":
        pass
    elif op == "describe-addresses":
        e = st["eips"].get("macrae-backend")
        print(f"{e['id']}\t{e['ip']}\t{e['instance'] or 'None'}" if e else "None\tNone\tNone")
    elif op == "allocate-address":
        st["eips"]["macrae-backend"] = {"id": "eipalloc-1", "ip": "3.120.5.7", "instance": None}
        print("eipalloc-1\t3.120.5.7")
    elif op == "associate-address":
        st["eips"]["macrae-backend"]["instance"] = opt("--instance-id")
    elif op == "release-address":
        st["eips"].pop("macrae-backend", None)
    else:
        fail("Fake", f"unhandled ec2 {op}")
else:
    fail("Fake", f"unhandled {svc} {op}")
save()
