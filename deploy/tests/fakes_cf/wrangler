#!/usr/bin/env python3
"""Fake wrangler for cloudflare/deploy.sh tests. State in $FAKE_DIR/cf.json, calls in $FAKE_DIR/wrangler.log.
FAKE_LOGGED_OUT=1, FAKE_WORKER_SECRETS='["A","B"]' (missing = no Worker yet), FAKE_DEPLOY_FAIL=1."""
import json, os, shutil, sys
from pathlib import Path

d = Path(os.environ["FAKE_DIR"])
state_file = d / "cf.json"
st = json.loads(state_file.read_text()) if state_file.exists() else {"buckets": [], "objects": {}, "deploys": []}
args = sys.argv[1:]
with open(d / "wrangler.log", "a") as f:
    f.write(" ".join(args) + "\n")

def save():
    state_file.write_text(json.dumps(st))

def arg(name):
    return args[args.index(name) + 1] if name in args else None

if args[:1] == ["whoami"]:
    print("You are not authenticated. Please run `wrangler login`." if os.environ.get("FAKE_LOGGED_OUT") else
          "You are logged in with an OAuth Token, associated with the email owner@example.com.")
elif args[:2] == ["secret", "list"]:
    names = os.environ.get("FAKE_WORKER_SECRETS")
    if names is None:
        print("✘ [ERROR] This Worker does not exist on your account. [code: 10007]", file=sys.stderr)
        sys.exit(1)
    print(json.dumps([{"name": n, "type": "secret_text"} for n in json.loads(names)], indent=2))
elif args[:3] == ["r2", "bucket", "info"]:
    sys.exit(0 if args[3] in st["buckets"] else 1)
elif args[:3] == ["r2", "bucket", "create"]:
    st["buckets"].append(args[3]); save()
elif args[:3] == ["r2", "object", "put"]:
    assert "--remote" in args
    st["objects"][args[3]] = Path(arg("--file")).read_text(); save()
elif args[:3] == ["r2", "object", "get"]:
    assert "--remote" in args and "--pipe" in args
    if args[3] not in st["objects"]:
        print("The specified key does not exist.", file=sys.stderr); sys.exit(1)
    sys.stdout.write(st["objects"][args[3]])
elif args[:3] == ["r2", "object", "delete"]:
    st["objects"].pop(args[3], None); save()
elif args[:2] == ["secret", "bulk"]:
    st.setdefault("bulk", []).append(json.loads(Path(args[2]).read_text())); save()
    print("✨ Successfully created secret(s)")
elif args[:1] == ["deploy"]:
    if os.environ.get("FAKE_DEPLOY_FAIL"):
        print("✘ [ERROR] Docker build failed", file=sys.stderr); sys.exit(1)
    secrets = json.loads(Path(arg("--secrets-file")).read_text()) if "--secrets-file" in args else {}
    st["deploys"].append({"args": args, "secrets": secrets}); save()
    print("Uploaded macrae (3.1 sec)\nDeployed macrae triggers (0.5 sec)\n  https://macrae.owner.workers.dev\n"
          "Current Version ID: 1234")
else:
    print(f"fake wrangler: unexpected {args}", file=sys.stderr); sys.exit(2)
